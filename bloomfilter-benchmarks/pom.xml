<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.codingdevs.bloomfilter</groupId>
        <artifactId>bloomfilter-monorepo</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>bloomfilter-benchmarks</artifactId>
    <name>BloomFilter Load Testing &amp; JMH Benchmarks</name>
    <description>Gatling HTTP load simulations, JMeter test plans, and OpenJDK JMH microbenchmarks for L1/L2 Cache Penetration &amp; Filter Throughput.</description>

    <dependencies>
        <dependency>
            <groupId>com.codingdevs.bloomfilter</groupId>
            <artifactId>bloomfilter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <configuration>
                    <simulationClass>com.codingdevs.bloomfilter.benchmarks.gatling.CachePenetrationSimulation</simulationClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
