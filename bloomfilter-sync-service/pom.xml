<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.codingdevs.bloomfilter</groupId>
        <artifactId>bloomfilter-monorepo</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>bloomfilter-sync-service</artifactId>
    <name>BloomFilter Sync Microservice</name>
    <description>Spring Boot 3.3.4 High-Availability Microservice exposing L1/L2 Bloom Filter APIs, Cache Penetration Protection, Zero-Downtime Rotation, and Prometheus Telemetry.</description>

    <dependencies>
        <dependency>
            <groupId>com.codingdevs.bloomfilter</groupId>
            <artifactId>bloomfilter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.codingdevs.bloomfilter</groupId>
            <artifactId>bloomfilter-redis-sdk</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
